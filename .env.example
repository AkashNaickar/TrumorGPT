# TrumorGPT environment configuration
# Copy to .env and fill in optional keys. All keys are optional — without any
# key the pipeline falls back to local Ollama, then to the rule-based extractor.

# Google Gemini API key (primary hosted LLM for triple extraction)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternative name accepted for the Gemini key
GOOGLE_API_KEY=

# OpenAI API key (fallback hosted LLM for triple extraction)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
